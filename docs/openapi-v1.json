          "end_local": {
            "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$",
            "title": "End Local",
            "type": "string"
          },
          "start_local": {
            "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$",
            "title": "Start Local",
            "type": "string"
          },
          "timezone": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Timezone",
            "type": "string"
