{
  "id": null,
  "uid": "ingen-fleet-health",
  "title": "InGen Fleet Health",
  "description": "Registry heartbeat and version inventory alongside simulator agent failures.",
  "tags": [
    "inGen",
    "week-5"
  ],
  "editable": true,
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "prometheus",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "selected": true,
          "text": "InGen Prometheus",
          "value": "ingen-prometheus"
        }
      },
      {
        "name": "stale_seconds",
        "label": "Stale after (s)",
        "type": "custom",
        "query": "10,15,30,60",
        "current": {
          "selected": true,
          "text": "15",
          "value": "15"
        },
        "options": [
          {
            "selected": false,
            "text": "10",
            "value": "10"
          },
          {
            "selected": true,
            "text": "15",
            "value": "15"
          },
          {
            "selected": false,
            "text": "30",
            "value": "30"
          },
          {
            "selected": false,
            "text": "60",
            "value": "60"
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Robots registered",
      "description": "Total registered robots, including those without an active artifact.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$prometheus"
          },
          "refId": "A",
          "expr": "sum(ingen_registry_active_versions) or vector(0)",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Robots late",
      "description": "Robots whose last accepted heartbeat exceeds the selected age.",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 1,
                "color": "orange"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$prometheus"
          },
          "refId": "A",
          "expr": "count(ingen_registry_robot_heartbeat_age_seconds > ${stale_seconds}) or vector(0)",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Agent metrics targets up",
      "description": "How many simulator agent endpoints Prometheus successfully scrapes.",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$prometheus"
          },
          "refId": "A",
          "expr": "sum(up{job=\"fleet-agent\"}) or vector(0)",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "Robots by artifact version",
      "description": "Last reported active artifact for every robot. Counts include stale reports.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$prometheus"
          },
          "refId": "A",
          "expr": "sum by (model, version, digest) (ingen_registry_active_versions)",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "job": true,
              "instance": true,
              "__name__": true
            },
            "indexByName": {
              "model": 0,
              "version": 1,
              "digest": 2,
              "Value": 3
            },
            "renameByName": {
              "model": "Model",
              "version": "Version",
              "digest": "Digest",
              "Value": "Robots"
            }
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Robots with late heartbeats",
      "description": "A stopped robot remains here because the age comes from the Registry database.",
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 15,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$prometheus"
          },
          "refId": "A",
          "expr": "ingen_registry_robot_heartbeat_age_seconds > ${stale_seconds}",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "job": true,
              "instance": true,
              "__name__": true
            },
            "indexByName": {
              "robot_id": 0,
              "site": 1,
              "Value": 2
            },
            "renameByName": {
              "robot_id": "Robot ID",
              "site": "Site",
              "Value": "Heartbeat age (s)"
            }
          }
        }
      ]
    },
    {
      "id": 6,
      "type": "table",
      "title": "Robots yet to report",
      "description": "Registered robots that have never sent an accepted heartbeat.",
      "gridPos": {
        "x": 15,
        "y": 11,
        "w": 9,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$prometheus"
          },
          "refId": "A",
          "expr": "ingen_registry_robot_heartbeat_received == 0",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "job": true,
              "instance": true,
              "__name__": true,
              "Value": true
            },
            "indexByName": {
              "robot_id": 0,
              "site": 1
            },
            "renameByName": {
              "robot_id": "Robot ID",
              "site": "Site"
            }
          }
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Agent failures in the last five minutes",
      "description": "Increase in the agent counters, summed across the fleet.",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$prometheus"
          },
          "refId": "A",
          "expr": "sum(increase(ingen_agent_download_failures_total[5m]))",
          "instant": false,
          "range": true,
          "format": "time_series",
          "legendFormat": "Download"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$prometheus"
          },
          "refId": "B",
          "expr": "sum(increase(ingen_agent_verification_failures_total[5m]))",
          "instant": false,
          "range": true,
          "format": "time_series",
          "legendFormat": "Verification"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$prometheus"
          },
          "refId": "C",
          "expr": "sum(increase(ingen_agent_smoke_test_failures_total[5m]))",
          "instant": false,
          "range": true,
          "format": "time_series",
          "legendFormat": "Smoke test"
        }
      ]
    }
  ]
}
