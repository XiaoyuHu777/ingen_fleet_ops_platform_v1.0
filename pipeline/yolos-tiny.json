{
  "name": "yolos-tiny",
  "version": "1.0.0",
  "inputs": {
    "name": "pixel_values",
    "shape": [1, 3, 256, 320],
    "dtype": "float32",
    "layout": "NCHW",
    "color_order": "RGB",
    "resize": "bilinear_half_pixel_clamp_no_antialias",
    "uint8_scale": 255,
    "mean": [0.485, 0.456, 0.406],
    "std": [0.229, 0.224, 0.225]
  },
  "score_threshold": 0.5,
  "parity_tolerance": 0.001
}
